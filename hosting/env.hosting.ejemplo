# =====================================================================
# APPSOLAR - Variables de entorno para el HOSTING (produccion).
#
# Se pueden cargar de dos maneras (elija UNA):
#   a) Copiar este archivo como ".env" dentro de la carpeta de la aplicacion
#      (fuera de public_html) y completar los valores.
#   b) Cargarlas una por una en cPanel > Setup Node.js App > Environment variables.
#
# Los valores CAMBIE_ESTE_VALOR hacen que el sistema se NIEGUE a iniciar:
# es intencional, para que nunca arranque con secretos de ejemplo.
# =====================================================================

NODE_ENV=production
TZ=America/Guatemala
APP_NAME="Monitoreo Energetico Retse"

# ---------- Dominio ----------
# Direccion publica completa, con https y SIN barra final.
APP_PUBLIC_URL=https://CAMBIE_ESTE_DOMINIO
CORS_ORIGINS=https://CAMBIE_ESTE_DOMINIO
# Detras del proxy de cPanel/Passenger.
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---------- Servidor ----------
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
LOG_LEVEL=info

# ---------- Base de datos MySQL (creada en cPanel > MySQL Databases) ----------
# En cPanel el nombre de la base y del usuario llevan prefijo de la cuenta,
# por ejemplo: micuenta_appsolar / micuenta_appuser
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CAMBIE_ESTE_VALOR
DB_USER=CAMBIE_ESTE_VALOR
DB_PASSWORD=CAMBIE_ESTE_VALOR
DB_CONNECTION_LIMIT=10

# Crea las tablas y el administrador inicial al arrancar (no requiere terminal).
# Es seguro dejarlo en true: solo aplica lo que falte.
AUTO_MIGRATE=true

# ---------- Seguridad / sesiones ----------
# Cada valor debe ser distinto y de 64 caracteres o mas (letras y numeros).
# Genere uno en: https://www.random.org/strings/  o con:  openssl rand -hex 48
JWT_ACCESS_SECRET=CAMBIE_ESTE_VALOR_ACCESS
JWT_REFRESH_SECRET=CAMBIE_ESTE_VALOR_REFRESH
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# ---------- Administrador inicial ----------
# Se crea una sola vez, en el primer arranque. Contrasena fuerte (12+ caracteres,
# mayuscula, minuscula, numero y simbolo). Cambiela al entrar por primera vez.
BOOTSTRAP_ADMIN_EMAIL=CAMBIE_ESTE_CORREO
BOOTSTRAP_ADMIN_NAME="Administrador del Sistema"
BOOTSTRAP_ADMIN_PASSWORD="CAMBIE_ESTE_VALOR_FUERTE"
SEED_DEMO_DATA=false

# ---------- Archivos cargados ----------
# Ruta ABSOLUTA FUERA de public_html (que nunca sea alcanzable por el navegador).
# Ejemplo: /home/micuenta/appsolar_datos/uploads
UPLOAD_DIR=/home/CAMBIE_CUENTA/appsolar_datos/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXT=.csv,.xlsx

# ---------- Integracion Huawei FusionSolar ----------
# El hosting no ejecuta Python: se usa el adaptador incluido en la aplicacion.
HUAWEI_ADAPTER=node
HUAWEI_MODE=real
HUAWEI_BASE_URL=https://intl.fusionsolar.huawei.com/thirdData
HUAWEI_USERNAME=
# Comillas obligatorias si la clave contiene el simbolo #
HUAWEI_SYSTEM_CODE=""
HUAWEI_AUTHORIZED_IP=

# Sincronizacion automatica diaria. En hosting compartido el proceso puede
# dormirse por inactividad: se recomienda dejarla en false y sincronizar
# manualmente, o programarla con un Cron Job de cPanel.
SYNC_CRON_ENABLED=false
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=30
