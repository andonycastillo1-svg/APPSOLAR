{
  "name": "@appsolar/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST y logica de negocio del sistema de monitoreo energetico de Retse, S.A.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:create": "tsx src/db/cli.ts create",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:reset": "tsx src/db/cli.ts reset",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:bootstrap": "tsx src/db/cli.ts bootstrap",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint \"src/**/*.ts\"",
    "db:plantillas": "tsx src/db/generarPlantillas.ts",
    "db:plantilla-carga": "tsx src/db/cargaMasiva.ts plantilla",
    "db:carga-masiva": "tsx src/db/cargaMasiva.ts sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pino": "^9.0.0",
    "pino-http": "^10.1.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
