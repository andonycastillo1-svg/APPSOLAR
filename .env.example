# =====================================================================
# APPSOLAR - Variables de entorno (ejemplo). NO contiene secretos reales.
# Copie este archivo a .env y complete los valores de su entorno.
# =====================================================================

# ---------- General ----------
NODE_ENV=development
TZ=America/Guatemala
APP_NAME="Monitoreo Energetico Retse"
APP_PUBLIC_URL=http://localhost:5173

# ---------- Backend Node.js ----------
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=1

# ---------- Base de datos MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appsolar
DB_PASSWORD=CAMBIE_ESTE_VALOR
DB_NAME=appsolar
DB_CONNECTION_LIMIT=10

# Usuario administrador de MySQL usado UNICAMENTE por los scripts de
# creacion de base de datos / respaldo (no lo usa la aplicacion).
DB_ROOT_USER=root
DB_ROOT_PASSWORD=CAMBIE_ESTE_VALOR
MYSQL_BIN_DIR=

# ---------- Seguridad / sesiones ----------
# Genere valores aleatorios de 64+ caracteres:  openssl rand -hex 48
JWT_ACCESS_SECRET=CAMBIE_ESTE_VALOR_ACCESS
JWT_REFRESH_SECRET=CAMBIE_ESTE_VALOR_REFRESH
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# ---------- Cargas de archivos ----------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXT=.csv,.xlsx

# ---------- Servicio Python (interno, NO exponer a Internet) ----------
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TOKEN=CAMBIE_ESTE_VALOR_TOKEN_INTERNO
PYTHON_SERVICE_TIMEOUT_MS=45000

# ---------- Integracion Huawei SmartPVMS ----------
# HUAWEI_MODE: mock | real   (real requiere credenciales validas + IP autorizada)
HUAWEI_MODE=mock
HUAWEI_BASE_URL=https://intl.fusionsolar.huawei.com/thirdData
HUAWEI_USERNAME=
HUAWEI_SYSTEM_CODE=
HUAWEI_TIMEOUT_S=40
HUAWEI_MAX_RETRIES=3
HUAWEI_AUTHORIZED_IP=

# ---------- Sincronizacion programada ----------
SYNC_CRON_ENABLED=false
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=30

# ---------- Bootstrap del administrador inicial ----------
# Solo se usa por el comando `npm run db:seed` / `db:bootstrap`.
# Encierre el valor entre comillas: sin ellas, un caracter # inicia un comentario.
BOOTSTRAP_ADMIN_EMAIL=admin@retse.com.gt
BOOTSTRAP_ADMIN_NAME="Administrador del Sistema"
BOOTSTRAP_ADMIN_PASSWORD="CAMBIE_ESTE_VALOR_FUERTE"
# Habilita usuarios y datos ficticios de demostracion (nunca en produccion)
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD="CAMBIE_ESTE_VALOR_DEMO"

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:4000/api
VITE_APP_NAME="Monitoreo Energetico Retse"
